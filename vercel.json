{
  "version": 2,
  "rewrites": [
    {
      "source": "/(predict|health|schema|threshold|insights|explain)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/workflow.html",
      "destination": "/workflow.html"
    },
    {
      "source": "/workflow.png",
      "destination": "/workflow.png"
    },
    {
      "source": "/workflow.svg",
      "destination": "/workflow.svg"
    },
    {
      "source": "/workflow.json",
      "destination": "/workflow.json"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
