# ==============================================================================
# RiskLens Credit Risk Assessment Engine - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed client origins
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Model Artifact & Data Paths
MODEL_PATH=models/risk_model.joblib
SAMPLE_REQUEST_PATH=models/sample_request.json
BENCHMARK_REPORT_PATH=reports/benchmark.json
THRESHOLD_PATH=reports/threshold.json

# Business Governance & Decision Thresholds
# 5:1 False Negative to False Positive Asymmetric Loss Matrix
DEFAULT_DECISION_THRESHOLD=0.160
COST_RATIO_FN_TO_FP=5.0
